# ============================================================
#  Luminara backend configuration
#  Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# ---------- Multimodal brain (OCR, diagram reading, notes, translation) ----------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Leave blank to auto-select the best available model at startup.
# Preference order used when blank: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=

# ---------- IBM Bob (primary engine: vision, reasoning, translation, agent) ----------
# Values below are the verified configuration for IBM Bob. They were derived from
# the Bob IDE's own client bundle, not guessed:
#   DEFAULT_GATEWAY_BASE_URL = https://api.us-east.bob.ibm.com
#   INFERENCE_SERVICE_PATH   = /inference/v1
#   auth header              = "Authorization: apikey <key>"      (NOT Bearer)
#
# Confirm your account's region before changing the host — the gateway rejects
# an instance used outside its region:
#   GET https://api.us-east.bob.ibm.com/admin/v1/profile
#       -> {"instances":[{"region":"us-east","region_domain":"us-east.bob.ibm.com", ...}]}
#
# List the models your key can use (OpenAI-style /models is not exposed; use):
#   GET {BOB_API_BASE}/model/info
#
# Adapter protocols supported by Luminara:
#   openai     -> POST {BOB_API_BASE}/chat/completions   (IBM Bob speaks this)
#   anthropic  -> POST {BOB_API_BASE}/v1/messages
#   gemini     -> POST {BOB_API_BASE}/v1beta/models/{model}:generateContent
#   custom     -> POST {BOB_API_BASE}{BOB_PATH} with {"prompt": ..., "context": ...}
BOB_API_BASE=https://api.us-east.bob.ibm.com/inference/v1
BOB_API_KEY=
# Model aliases on IBM Bob: premium (Claude Sonnet 4.5), ultra (Opus), fast
# (Haiku 4.5), sonnet-4.6, gpt-2026-5.4, gemini-3.5-flash, granite-8b-code-instruct …
BOB_MODEL=premium
BOB_PROTOCOL=openai
# Only used when BOB_PROTOCOL=custom
BOB_PATH=/ask
# How the key is sent: apikey | bearer | x-api-key | query
BOB_AUTH_STYLE=apikey
# The gateway is WAF-protected and rejects unrecognised clients (a browser-like
# User-Agent is blocked outright). This is the IDE's own agent string.
BOB_USER_AGENT=bobide/1.0.0
# Vision-capable model for whiteboard OCR + diagram understanding.
BOB_VISION_MODEL=premium
# Cheaper tier for high-volume, low-reasoning work (translation).
BOB_FAST_MODEL=fast

# ---------- Speech recognition (runs locally, no key needed) ----------
# tiny | base | small   (base is pre-cached on the build machine)
WHISPER_MODEL=base
# cpu | cuda
WHISPER_DEVICE=cpu

# ---------- Server ----------
HOST=0.0.0.0
PORT=8000
# Comma-separated. * is fine for a hackathon prototype on a local network.
CORS_ORIGINS=*

# ---------- Behaviour ----------
# Languages offered to students (ISO 639-1)
SUPPORTED_LANGUAGES=en,hi,bn,ar
# Set to 1 to force the offline deterministic engine even when keys are present
FORCE_OFFLINE=0
